			 MacroDepth        = $MacroDepth1	;  
		         horizon   	= 1       2       3	; #G/Ske/D/Spv: 3/4/4/3 	
			 Name		= H_SCL   H_SCL   SCL   ;  	
        		 ksat      	= $3e6 	  $3e6 	  $1e6	;	
	       		 k_recession    = 0.9     0.9     0.9   ; #Skelett 20-50% 	
		         theta_sat 	= 0.27    0.27    0.27  ; #ori: 0.39 0.39	
		         theta_res 	= 0.070   0.070   0.070 ; #ori: 0.1 0.1	
			 (hPa)psi_FC	= $SCL	  $SCL	  $SCL	;
		         alpha     	= 5.9 	  5.9 	  5.9	;	
		         Par_n     	= 1.48    1.48    1.48  ;	
		         Par_tau	= 0.5	  0.5	  0.5	;  	
		         thickness 	= 0.10    0.2     0.625 ; # 6.0 m	
		         layers    	= 4       3	  8	;
		        }
70	P8_Mulden {method = MultipleHorizons; 
			 PMacroThresh      = $PMacroThresh1	;  
			 MacroCapacity     = $MacroCapacity1	; 
			 CapacityRedu      = $CapacityRedu1	;   
			 MacroDepth        = $MacroDepth1	;  
		         horizon   	= 1       2	; #G/Ske/D/Spv: 3/3/3/-4  	
			 Name		= H_SC    SICL  ;  	
        		 ksat      	= $3e7 	  $1e7	;	
	       		 k_recession    = 0.95    0.95  ; #Skelett 10-20% 	
		         theta_sat 	= 0.32    0.37  ; #ori: 0.38 0.43	
		         theta_res 	= 0.085   0.076 ; #ori: 0.10 0.089	
			 (hPa)psi_FC	= $SC	  $SICL	;
		         alpha     	= 2.7 	  1.0	;	
		         Par_n     	= 1.23    1.23  ;	
		         Par_tau	= 0.5	  0.5	;  	
		         thickness 	= 0.30    1.75  ; #19m
		         layers    	= 5       10	;
		        }


