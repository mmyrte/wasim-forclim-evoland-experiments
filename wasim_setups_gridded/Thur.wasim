$set $chillingunitsgrid3   =  chill3//.//$suffix
$set $FStargrid3           =  fstar3//.//$suffix
$set $albedo               =  albedo//.//$suffix
$set $soilstoragegrid      =  sb__//.//$suffix
$set $throughfall          =  qi__//.//$suffix
$set $snowcover_outflow    =  qsno//.//$suffix
$set $melt_from_snowcover  =  qsme//.//$suffix
$set $days_snow            =  sday//.//$suffix
$set $snow_age             =  sage//.//$suffix
$set $snow_rate            =  snow//.//$suffix
$set $rain_rate            =  rain//.//$suffix
$set $firn_melt            =  qfir//.//$suffix
