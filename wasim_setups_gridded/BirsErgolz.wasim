6	H3_Steilhaenge_vorwieg_Molasse {
			 method = MultipleHorizons;
			 ThicknessScaling  = $ThicknessScaling1 ; 
			MaxInterflowDepth = $MaxInterflowdepth ;
			 PMacroThresh   = 8.0 ;  
			 MacroCapacity  = 0.5 ; 
			 CapacityRedu   = 0.7 ;   
			 MacroDepth     = 1.0 ;  
		         horizon   	= 1       2	; #G/Ske/D/Spv: 4/3/4/4  	
			 Name		= H_L	  SIL	;  	
        		 ksat      	= $3e6 	  $1e6	;	
	       		 k_recession    = 0.95	  0.95  ; #Skelett bis 10-20%  	
		         theta_sat 	= 0.37    0.38  ; #ori: 0.43   0.45	
		         theta_res 	= 0.066   0.057 ; #ori: 0.078  0.067	
			 (hPa)psi_FC	= $L	  $SIL	;
		         alpha     	= 3.6 	  2.0	;	
		         Par_n     	= 1.56    1.41  ;	
		         Par_tau	= 0.5	  0.5	;  	
		         thickness 	= 0.20    0.50  ; #6m
		         layers    	= 5       10	;
		        }


