13	7_Siedlungsflaechen {
			 method = MultipleHorizons;
			 ThicknessScaling  = $ThicknessScaling1 ; #vgl. 8	# AE = 0.42 %		
			 MaxInterflowDepth = $MaxInterflowdepth ;
			 PMacroThresh   = 8.0 ;  
			 MacroCapacity  = 0.5 ; 
			 CapacityRedu   = 0.7 ;   
			 MacroDepth     = 1.0 ;  
		         horizon   	= 1       2	 3	;  	
			 Name		= SIL	  SIL	 R	;  	
        		 ksat      	= $1e6 	  $3e7   $5e8   ; # SIL: $1e6	
	       		 k_recession    = 0.9     0.9    0.9    ;  	
		         theta_sat 	= 0.45    0.45   0.20   ;	
		         theta_res 	= 0.067   0.067  0.04   ;	
			 (hPa)psi_FC	= $SIL	  $SIL	 $R	;
		         alpha     	= 2.0 	  2.0	 8.0	;	
		         Par_n     	= 1.41    1.41   1.80   ;	
		         Par_tau	= 0.5	  0.5	 0.5	;  	
		         thickness 	= 0.10    0.30   2.00   ;	# 19.0 m
		         layers    	= 4       2       9     ;
		        }
