# result stackd for layered snow model
$set $SWESstack			= swes_stack//.//$suffix	# stack with SWE solid values per snow layer
$set $SWELStack			= swel_stack//.//$suffix	# stack with SWE liquid values per snow layer
$set $temperSnowStack		= tempersnow_stack//.//$suffix	# stack with snow temperatures per snow layer
$set $thetaSnowStack		= thetasnow_stack//.//$suffix	# stack with theta values per snow layer
$set $hhSnowStack		= hhydsnow_stack//.//$suffix	# stack with hydraulic heads per snow layer
$set $hgeoSnowStack		= hgeosnow_stack//.//$suffix	# stack with geodetic elevation per snow layer (bottom of layer)
$set $quSnowStack		= qusnow_stack//.//$suffix	# stack with (bottom) water fluxes per snow layer
$set $thickSnowStack		= thicksnow_stack//.//$suffix	# stack with the thickness of each snow layer
$set $densSnowStack		= denssnow_stack//.//$suffix	# stack with density of each snow layer
$set $upperIndexSnow		= upperIndexSnow//.//$suffix	# grid with the index of the first (uppermost) layer that constains snow


# parameters for interpolation of meteorological input data
$set $SzenUse        =  0
$set $IDWmaxdist     =  100000
$set $IDWweight      =  2
$set $Anisoslope     =  60.0
$set $Anisotropie    =  0.65


# explanation of writegrid and outputcode some lines below
$set $Writegrid_series 	= 3
$set $Writegrid      	= 3
$set $Write_no_grid  	= 0
$set $Writestack     	= 3
$set $Write_no_stack 	= 0

$set $no_output  	 =  0
$set $once_per_interval  =  2001
$set $routing_code       =  4001


[SpinUp]
$do_spin_up


[output_list]
