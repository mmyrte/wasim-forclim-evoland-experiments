			 method = MultipleHorizons;
			 ThicknessScaling  = $ThicknessScaling3 ;
 			 MaxInterflowDepth = $MaxInterflowdepth ;
			 PMacroThresh   = 8.0 ;  
			 MacroCapacity  = 0.5 ; 
			 CapacityRedu   = 0.7 ;   
			 MacroDepth     = 1.0 ;  
		         horizon   	= 1       2	; #G/Ske/D/Spv: 5/3/6/4	
			 Name		= H_S     S     ;  	
        		 ksat      	= $3e4 	  $1e4	;	
	       		 k_recession    = 0.95    0.95  ; #Skelett 10-20% 	
		         theta_sat 	= 0.37    0.37  ; #ori: 0.43  0.43	
		         theta_res 	= 0.038   0.038 ; #ori: 0.045 0.045	
			 (hPa)psi_FC	= $S	  $S	;
		         alpha     	= 14.5 	  14.5	;	
		         Par_n     	= 2.68    2.68  ;	
		         Par_tau	= 0.5	  0.5	;  	
		         thickness 	= 0.30    1.75  ; #19m
		         layers    	= 5       10	;
		        }
#TIEFERES_MOLASSEHUEGELLAND_MIT_TEILWEISER_MORAENEBEDECKUNG
12	H1_Leicht_gewelltes_Plateaus_und_Hangterrassen_tonige_Moraene {
			 method = MultipleHorizons;
			 ThicknessScaling  = $ThicknessScaling2;
			 MaxInterflowDepth = $MaxInterflowdepth ;
			 PMacroThresh   = 8.0 ;  
			 MacroCapacity  = 0.5 ; 
			 CapacityRedu   = 0.7 ;   
			 MacroDepth     = 1.0 ;  
		         horizon   	= 1       2	; #G/Ske/D/Spv: 5/3/4/6  	
			 Name		= H_L	  SIL	;  	
        		 ksat      	= $3e6 	  $1e6	;	
	       		 k_recession    = 0.95    0.95  ; #Skelett bis 10-20%  	
		         theta_sat 	= 0.37    0.38  ; #ori: 0.43   0.45	
		         theta_res 	= 0.066   0.057 ; #ori: 0.078  0.067	
			 (hPa)psi_FC	= $L	  $SIL	;
		         alpha     	= 3.6 	  2.0	;	
		         Par_n     	= 1.56    1.41  ;	
		         Par_tau	= 0.5	  0.5	;  	
		         thickness 	= 0.20    0.30  ; #4m
		         layers    	= 5       10	;
		        }
