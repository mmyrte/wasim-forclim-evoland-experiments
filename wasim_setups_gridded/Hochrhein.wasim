[abstraction_rule_reservoir_1] 	# Bodensee (Obersee)
-1 				# special tag to mark the following hydraulic rule
HydraulicConnection 
{
	TargetReservoir = 2;
	ChannelWidth = 150;
	ChannelBottom = 388.23; //in m  .M.
	ChannelLength = 4300; // in m
	RoughnessCoeff = 15; 	# here we need to implement a change over time, e.g. in summer because of growing water plants the roughness must become much smaller, possible even from year to year
}


