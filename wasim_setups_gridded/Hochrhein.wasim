12 uebrige_Gruenfl	{ Landuse_Layers = 6,  -9999;	k_extinct = 0.3; LAI_scale = 20;}
13 Moore_Suempfe	{ Landuse_Layers = 15,  -9999;	k_extinct = 0.3; LAI_scale = 20;}
14 versteinte_wiesen	{ Landuse_Layers = 4,  -9999;	k_extinct = 0.3; LAI_scale = 20;}
