# parameters for interpolation of meteorological input data
$set $SzenUse        =  0
$set $IDWmaxdist     =  100000
$set $IDWweight      =  2
$set $Anisoslope     =  -10.0
$set $Anisotropie    =  0.65

$set $AnisoslopeReg1     =  30.0
$set $AnisotropieReg1    =  0.65
$set $AnisoslopeReg2     =  45.0
$set $AnisotropieReg2    =  0.65


# explanation of writegrid and outputcode some lines below
$set $Writegrid_series 	= 3
$set $Writegrid      	= 3
$set $Write_no_grid  	= 0
$set $Writestack     	= 3
$set $Write_no_stack 	= 0

$set $no_output  	 = 0
$set $once_per_interval  = 2001
$set $routing_code       = 4001


[SpinUp]
$do_spin_up


[output_list]
40     # number of subbasins which are scheduled for output (is only of interest, if the code for the statistic files are >5000)
