23	1_Seen_subhydrische_Boeden {
			 method = MultipleHorizons;
			 ThicknessScaling= $ThicknessScaling3 ; 	# AE = 0.28 %
			 PMacroThresh   = $PMacroThresh23;
			 MacroCapacity  = $MacroCapacity23;
			 CapacityRedu   = $CapacityRedu23;
			 MacroDepth     = $MacroDepth23;
		         horizon  	= 1	2	3	;
			 Name		= SIL	SIL	CL	;
        		 ksat   	= $3e7	$1e7	$1e7	; 	# SIL: $1e6
	       		 k_recession    = 0.9	0.9	0.9	;
		         theta_sat 	= 0.45	0.45	0.40	;
		         theta_res 	= 0.067	0.067	0.095	;
			(hPa)psi_FC	= $SIL	$SIL	$CL	;
		         alpha     	= 2.00	2.0	1.90	;
		         Par_n     	= 1.41	1.41	1.31	;
		         Par_tau	= 0.5	0.5	0.5	;
		         thickness 	= 0.10	0.30	2.00	;	# 19.0 m
		         layers    	= 4	2	9	;
		        }
