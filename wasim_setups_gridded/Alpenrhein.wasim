$set $snow_rate            =  snow//.//$suffix
$set $rain_rate            =  rain//.//$suffix
$set $firn_melt            =  qfir//.//$suffix
$set $ice_melt             =  qice//.//$suffix
$set $preci_grid           =  prec//.//$suffix
$set $preci_grid1          =  prec1//.//$suffix
$set $preci_grid2          =  prec2//.//$suffix
