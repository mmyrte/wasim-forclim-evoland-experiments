[routing_model]
$do_routing_model 					# 0=ignore this module, 1 = run the module, 2=run the module with observed inflows into the routing channels (from discharge files)
$time
1 4800 150 48         					# minimum/maximum specific discharge (l/s/km^2), number of log. fractions of the range, splitting of the timeintervall (24= 1 hour-intervalls are splitted into 24 Intervalls each of 2.5 min. duration)
$outpath//qgko.dat $routing_code
$inpath//$subdir_timeseries//obsrunoff_m3s.dat
