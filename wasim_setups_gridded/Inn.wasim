		IntercepCap 	= 0;
		JulDays  	= 365;
		Albedo 		= 0.15;
 		rsc 		= 1;
		rs_interception = 0;
		rs_evaporation 	= 0;
		LAI 		= 1;
		Z0 		= 0.1;
		VCF  		= 1;
		RootDepth  	= 1;
		AltDep  	= 0;
	        }
17 horticulture    {method   = VariableDayCount;
