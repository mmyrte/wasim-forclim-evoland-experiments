# 12 = dynamic glacier model with radiation correction, 
# 13 = like 12 but melt methods are taken from snow model (for snow only)

[ice_firn]
13   # method for glacier melt: 1=classical t-index, 2=t-index with correction by radiation, 11 = dynamic glacier model with classical t-index, 12 = dynamic glacier model with radiation correction
