14	23_Seen_subhydrische_Boeden {
			method = MultipleHorizons;
			ThicknessScaling	=	$ThicknessScaling3 ; 	
			MaxInterflowDepth	=	$MaxInterflowdepth3 ;
			PMacroThresh		= 0;  
			MacroCapacity		= 0; 
			CapacityRedu		= 0;   
			MacroDepth		= 0;  
			horizon			= 1	2	3	;  	
			Name			= SIL	SIL	CL	;  	
			ksat			= $3e7	$1e7	$1e7	; 
			k_recession		= 0.9	0.9	0.9	;  	
			theta_sat		= 0.45	0.45	0.40	;	
			theta_res		= 0.067	0.067	0.095	;	
			(hPa)psi_FC		= $SIL	$SIL	$CL	;
			alpha			= 2.00	2.0	1.90	;	
			Par_n			= 1.41	1.41	1.31	;	
			Par_tau			= 0.5	0.5	0.5	;  	
			thickness		= 0.10	0.30	2.00	;	# 19.0 m
			layers			= 9	2	9	;
		}
15	13_Siedlungsflaechen {
			method = MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ;
