			CapacityRedu   		= $CapacityRedu2;   
			MacroDepth     		= $MacroDepth2;  
		    	horizon   		= 1       2		;
			Name			= T_L	  Sub_L		;  	
			ksat      		= $1e5    $8e6		;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $L	  $L		;
			alpha     		= 1.6 	  1.6		;	
			Par_n     		= 1.42    1.42   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.20    0.30  	; #4m 
			layers    		= 10       10		;
		}
