#----------------------------------		
$set $ThicknessScaling1 = 2.0 # original:  2 m with factor=1 (in Karst extended to 14m)
$set $ThicknessScaling2 = 1.5 # original:  5 m with factor=1 (in Karst extended to 16m)
$set $ThicknessScaling3 = 1.2 # original: 17 m with factor=1


$set $MaxInterflowdepth1 = 1.5
$set $MaxInterflowdepth2 = 1.8
$set $MaxInterflowdepth3 = 2.1


$set $PMacroThresh1	= 8.0   
$set $MacroCapacity1 	= 0.5  
$set $CapacityRedu1	= 0.7    
$set $MacroDepth1 	= 1.0 

$set $PMacroThresh2	= 8.0   
$set $MacroCapacity2 	= 1.0
$set $CapacityRedu2	= 0.7    
$set $MacroDepth2 	= 1.5 

$set $PMacroThresh3	= 8.0   
$set $MacroCapacity3 	= 1.0
$set $CapacityRedu3	= 0.7    
$set $MacroDepth3 	= 2.0 

[GlobalSoilParameters]
psi_FC_global = 200; (hPa) 		# if this value is set, all soil types will use this value for all horizons, except when usePsiFCglobalForUnassignedOnly = 1;
usePsiFCglobalForUnassignedOnly = 1; 	# if 0: psi_FC_global is used for all soil types and horizons, wether the local value of psi_FC is set or not. if 1, then only those soil types will use the global value, that not have a local psi_FC set.

# field capacities (psi_FC):
# sand 60-100 hPa (100 hPa)
# silt 100-300 hPa (200 hPa)
# clay 300-500 hPa (300 hPa)

$set $S		= 60 	# sand
$set $LS	= 100 	# loamy sand
$set $SL	= 150 	# sandy loam
$set $L		= 200 	# loam
$set $SC	= 200 	# sandy clay
$set $SIL	= 250 	# silty loam
$set $SICL	= 300 	# silty clay loam
$set $CL	= 300 	# clay loam
$set $SIC	= 350 	# silty clay
$set $HMT	= 100 	# Hochmoortorf 
$set $NMT	= 100 	# Niedermoortorf 
$set $M		= 100 	# Moor
$set $R		= 100 	# rock


[soil_table]
9
#co- name of the 	# van Genuchten Parameter nach Carsel & Parrish (1988)
#de  soil profile
#-- ---------------
9	loam_shallow {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth1;
			PMacroThresh   		= $PMacroThresh1;  
			MacroCapacity  		= $MacroCapacity1; 
			CapacityRedu   		= $CapacityRedu1;   
			MacroDepth     		= $MacroDepth1;  
		    	horizon   		= 1       2		;
			Name			= T_L	  Sub_L		;  	
			ksat      		= $1e5    $8e6		;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $L	  $L		;
			alpha     		= 1.6 	  1.6		;	
			Par_n     		= 1.42    1.42   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.10    0.15  	; #2m 
			layers    		= 10       10		;
		}
29	loam_medium {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling2 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth2;
