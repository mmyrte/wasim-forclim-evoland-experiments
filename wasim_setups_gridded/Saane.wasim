# output grids for surface hydrology modules
$set $nFK_grid_mm_min      =  uFCminmm//.//$suffix 
$set $nFK_grid_mm_max      =  uFCmaxmm//.//$suffix 
$set $nFK_grid_mm          =  uFCmm//.//$suffix      
$set $nFK_grid_perc        =  uFCperc//.//$suffix 
