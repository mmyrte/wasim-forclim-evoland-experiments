  from AL 4 (modus = intern 0.025 0.95 3.2 m^3/s ) # parameters are: threshold, fraction, capacity
TG 15 (AE=12.75, AErel=1.0)
  from AL 5 (modus = intern 0.025 0.95 6.0 m^3/s ) # parameters are: threshold, fraction, capacity
