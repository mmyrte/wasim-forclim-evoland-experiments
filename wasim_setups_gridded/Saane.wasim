# == protected part to be changed by the module adapter ==
# == all manual changes in this section will be overwritten by the module adapter ==

$set $runID1      = 2021
$set $runID2      = 2022

$set $mainpath       = d:\_sim_\BAFU\SLF\Saane\
$set $inpath         =  $mainpath//Input\
$set $exchngpath     =  $mainpath//Exchng\
$set $InitialStateDirectory = $mainpath//StateIni_$runID1//\
$set $DefaultOutputDirectory = $mainpath//Output\

$set $time           = 60

$set $starthour      = 1
$set $startday       = 1
$set $startmonth     = 1
$set $startyear      = $runID1
$set $endhour        = 0
$set $endday         = 1
$set $endmonth       = 1
$set $endyear        = $runID2


# it is important to set $outpath to an empty string in order to activate $DefaultOutputDirectory
$set $outpath        =  

# readgrids : 1 = read storage grids (as SI, SSNOW,SLIQ...) from hard disk, 0=generate and initialize with 0
$set $readgrids     =  1

# read grids for dynamic phenology -> usually chilling grid should be read in if availabe because otherwise thermal time method will be applied and not the sequential model
$set $DPreadgrids   =  1

# == end of protected part ==

$set $subdir_ingrids = grids\
$set $subdir_timeseries = timeseries\

$set $do_RegionalSuperposition = 0
$set $do_precipitation_correction = 1
$set $do_radiation_correction = 1
$set $do_evapotranspiration = 1
$set $do_snow_model = 1
$set $do_interception_model = 1
$set $do_infiltration_model = 0 
$set $do_SiltingUpModel = 0
$set $do_SurfaceRoutingModel = 0
$set $do_lake_model = 1
$set $do_unsatzon_model = 1
$set $do_soil_model = 0
$set $do_heat_transfer = 0
$set $do_ExternalCoupling = 0
$set $do_irrigation = 0
$set $do_groundwater_flow = 1
$set $do_routing_model = 1
$set $do_substance_transport = 0
$set $do_irrigation_table = 0
$set $do_special_output = 0
$set $do_data_assimilation = 0
$set $do_spin_up = 0

$set $DPreadgrids   = 0


$set $grid           =  saane500
$set $stack          =  saane500
$set $suffix         =  grd
$set $code           =  s


# kd --> recession constant for single linear reservoir for direct runoff
$set $kd1     = 2
$set $kd2     = 2 
$set $kd3     = 2 
$set $kd4     = 2 
$set $kd5     = 2 
$set $kd6     = 2
$set $kd7     = 2 
$set $kd8     = 2 
$set $kd9     = 2 
$set $kd10    = 2 
$set $kd11    = 2
$set $kd12    = 2
$set $kd13    = 2
$set $kd14    = 2
$set $kd15    = 2
$set $kd16    = 2
$set $kd17    = 2
$set $kd18    = 2
$set $kd19    = 2

# ki --> recession constant for single linear reservoir for interflow
$set $ki1     = 2
$set $ki2     = 2 
$set $ki3     = 2 
$set $ki4     = 2 
$set $ki5     = 2 
$set $ki6     = 2
$set $ki7     = 2 
$set $ki8     = 2 
$set $ki9     = 2 
$set $ki10    = 2 
$set $ki11    = 2
$set $ki12    = 2
$set $ki13    = 2
$set $ki14    = 2
$set $ki15    = 2
$set $ki16    = 2
$set $ki17    = 2
$set $ki18    = 2
$set $ki19    = 2 

# dr --> drainage density (interflow generation parameter)
$set $dr1     = 15
$set $dr2     = 30
$set $dr3     = 4
$set $dr4     = 12
$set $dr5     = 6
$set $dr6     = 4
$set $dr7     = 4
$set $dr8     = 4
$set $dr9     = 4
$set $dr10    = 4
$set $dr11    = 4
$set $dr12    = 4
$set $dr13    = 4
$set $dr14    = 4
$set $dr15    = 4
$set $dr16    = 6
$set $dr17    = 15
$set $dr18    = 30
$set $dr19    = 6

# sdf --> Snow melt: Direct Runoff fraction
$set $sdf1     = 0.05
$set $sdf2     = 0.05 
$set $sdf3     = 0.05 
$set $sdf4     = 0.05 
$set $sdf5     = 0.05 
$set $sdf6     = 0.05
$set $sdf7     = 0.05 
$set $sdf8     = 0.05 
$set $sdf9     = 0.05 
$set $sdf10    = 0.05 
$set $sdf11    = 0.05
$set $sdf12    = 0.05
$set $sdf13    = 0.05
$set $sdf14    = 0.05
$set $sdf15    = 0.05
$set $sdf16    = 0.05
$set $sdf17    = 0.05
$set $sdf18    = 0.05
$set $sdf19    = 0.05


# variables for standardgrids
# first section: grids, which differ for different subdivisions of the basin
