$set $ETPgrid              =  etp_//.//$suffix
$set $EIPgrid              =  eip_//.//$suffix
$set $ETRgrid              =  etr_//.//$suffix
$set $EVAPgrid             =  evap//.//$suffix
$set $EVARgrid             =  evar//.//$suffix
$set $ETRSgrid             =  etrs//.//$suffix
$set $SSNOgrid             =  ssno//.//$suffix
$set $SLIQgrid             =  sliq//.//$suffix
