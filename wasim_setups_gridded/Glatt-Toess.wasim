$set $PMacroThresh1	= 8.0   
$set $MacroCapacity1 	= 4.0  
$set $CapacityRedu1	= 0.7    
$set $MacroDepth1 	= 1.0 

[GlobalSoilParameters]
psi_FC_global = 200; (hPa) 		# if this value is set, all soil types will use this value for all horizons, except when usePsiFCglobalForUnassignedOnly = 1;
usePsiFCglobalForUnassignedOnly = 1; 	# if 0: psi_FC_global is used for all soil types and horizons, wether the local value of psi_FC is set or not. if 1, then only those soil types will use the global value, that not have a local psi_FC set.

# field capacities (psi_FC):
# sand 60-100 hPa (100 hPa)
# silt 100-300 hPa (200 hPa)
# clay 300-500 hPa (300 hPa)

$set $S		= 60 	# sand
$set $LS	= 100 	# loamy sand
$set $SL	= 150 	# sandy loam
$set $L		= 200 	# loam
$set $SC	= 200 	# sandy clay
$set $SIL	= 250 	# silty loam
$set $SICL	= 300 	# silty clay loam
$set $CL	= 300 	# clay loam
$set $SIC	= 350 	# silty clay
$set $HMT	= 100 	# Hochmoortorf 
$set $NMT	= 100 	# Niedermoortorf 
$set $M		= 100 	# Moor
$set $R		= 100 	# rock

