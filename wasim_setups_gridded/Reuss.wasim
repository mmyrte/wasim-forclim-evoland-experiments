0.15 						# Albedo_OpenWater (will be used only, when the pond is filled with water when calculating potential evaporation -> otherwise, the normal landuse for this cell is referenced for this parameter)
0.05  						# z0 for water (usage as above) 
$readgrids                   			# readgrid code 0 do not read, 1 = read grids --> 
