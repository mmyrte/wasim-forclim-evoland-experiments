    AverageWaterTable = 886.50;
    listfilename = $inpath//$subdir_timeseries//zh598a_sihlsee.dat;
    options
    {
        format = wasim; 
        skiprows = 0;     # how many rows should be skipped if not for every time step the data assimilation should be done,
    }
}

