#----------------------------------		

$set $ThicknessScaling1 = 1.0 	# original:  4 m with factor=1 (in Karst extended to 14m)
$set $ThicknessScaling2 = 1.0 	# original:  6 m with factor=1 (in Karst extended to 16m)
$set $ThicknessScaling3 = 1.0 	# original: 19 m with factor=1

$set $MaxInterflowdepth1 = 1.2
$set $MaxInterflowdepth2 = 1.2
$set $MaxInterflowdepth3 = 1.2

$set $PMacroThresh1	= 8.0   
$set $MacroCapacity1 	= 0.5  
$set $CapacityRedu1	= 0.7    
$set $MacroDepth1 	= 1.0 

$set $PMacroThresh2	= 4.0   
$set $MacroCapacity2 	= 5.0
$set $CapacityRedu2	= 0.7    
$set $MacroDepth2 	= 1.5 

$set $PMacroThresh3	= 4.0   
$set $MacroCapacity3 	= 10.0
$set $CapacityRedu3	= 0.7    
$set $MacroDepth3 	= 2.0 


[GlobalSoilParameters]
psi_FC_global = 200; (hPa) 		# if this value is set, all soil types will use this value for all horizons, except when usePsiFCglobalForUnassignedOnly = 1;
usePsiFCglobalForUnassignedOnly = 1; 	# if 0: psi_FC_global is used for all soil types and horizons, wether the local value of psi_FC is set or not. if 1, then only those soil types will use the global value, that not have a local psi_FC set.

# field capacities (psi_FC):
# sand 60-100 hPa (100 hPa)
# silt 100-300 hPa (200 hPa)
# clay 300-500 hPa (300 hPa)

$set $S		= 60 	# sand
$set $LS	= 100 	# loamy sand
$set $SL	= 150 	# sandy loam
$set $L		= 200 	# loam
$set $SC	= 200 	# sandy clay
$set $SIL	= 250 	# silty loam
$set $SICL	= 300 	# silty clay loam
$set $CL	= 300 	# clay loam
$set $SIC	= 350 	# silty clay
$set $HMT	= 100 	# Hochmoortorf 
$set $NMT	= 100 	# Niedermoortorf 
$set $M		= 100 	# Moor
$set $R		= 100 	# rock


[soil_table]
10
#co- name of the 	# van Genuchten Parameter nach Carsel & Parrish (1988)
#de  soil profile
#-- ---------------
9	loam_shallow {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth1;
			PMacroThresh   		= $PMacroThresh1;  
			MacroCapacity  		= $MacroCapacity1; 
			CapacityRedu   		= $CapacityRedu1;   
			MacroDepth     		= $MacroDepth1;  
		    	horizon   		= 1       2		;
			Name			= T_L	  Sub_L		;  	
			ksat      		= $1e5    $8e6		;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $L	  $L		;
			alpha     		= 1.6 	  1.6		;	
			Par_n     		= 1.42    1.42   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.10    0.15  	; #2m 
			layers    		= 5       10		;
		}
29	loam_medium {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling2 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth2;
			PMacroThresh   		= $PMacroThresh2;  
			MacroCapacity  		= $MacroCapacity2; 
			CapacityRedu   		= $CapacityRedu2;   
			MacroDepth     		= $MacroDepth2;  
		    	horizon   		= 1       2		;
			Name			= T_L	  Sub_L		;  	
			ksat      		= $1e5    $8e6		;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $L	  $L		;
			alpha     		= 1.6 	  1.6		;	
			Par_n     		= 1.42    1.42   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.20    0.30  	; #4m 
			layers    		= 5       10		;
		}
49	loam_deep {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling3 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth3;
			PMacroThresh   		= $PMacroThresh3;  
			MacroCapacity  		= $MacroCapacity3; 
			CapacityRedu   		= $CapacityRedu3;   
			MacroDepth     		= $MacroDepth3;  
		    	horizon   		= 1       2		;
			Name			= T_L	  Sub_L		;  	
			ksat      		= $1e5    $8e6		;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $L	  $L		;
			alpha     		= 1.6 	  1.6		;	
			Par_n     		= 1.42    1.42   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.20    1.5   	; #16m 
			layers    		= 5       10		;
		}
11	sandy_loam_shallow {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth1;
			PMacroThresh   		= $PMacroThresh1;  
			MacroCapacity  		= $MacroCapacity1; 
			CapacityRedu   		= $CapacityRedu1;   
			MacroDepth     		= $MacroDepth1;  
		    	horizon   		= 1       2		;
			Name			= T_Ls	  Sub_Ls	;  	
			ksat      		= $2e5    $1.4e5	;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $SL	  $SL		;
			alpha     		= 3.6 	  3.6		;	
			Par_n     		= 2.1     2.1   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.10    0.15  	; #2m 
			layers    		= 5       10		;
		}
51	sandy_loam_deep {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling3 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth3;
			PMacroThresh   		= $PMacroThresh3;  
			MacroCapacity  		= $MacroCapacity3; 
			CapacityRedu   		= $CapacityRedu3;   
			MacroDepth     		= $MacroDepth3;  
		    	horizon   		= 1       2		;
			Name			= T_Ls	  Sub_Ls	;  	
			ksat      		= $2e5    $1.4e5	;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.40    0.38  	; 	
			theta_res 		= 0.080   0.110 	;	
			(hPa)psi_FC		= $SL	  $SL		;
			alpha     		= 3.6 	  3.6		;	
			Par_n     		= 2.1     2.1   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.20    1.5   	; #16m 
			layers    		= 5       10		;
		}
32	loamy_sand_medium {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling2 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth2;
			PMacroThresh   		= $PMacroThresh2;  
			MacroCapacity  		= $MacroCapacity2; 
			CapacityRedu   		= $CapacityRedu2;   
			MacroDepth     		= $MacroDepth2;  
		    	horizon   		= 1       2		;
			Name			= T_Sl	  Sub_Sl	;  	
			ksat      		= $1e4    $5e5	    	;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.37    0.30  	; 	
			theta_res 		= 0.080   0.10  	;	
			(hPa)psi_FC		= $LS	  $LS		;
			alpha     		= 4.0 	  4.0		;	
			Par_n     		= 3.0     3.0   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.20    0.30  	; #4m 
			layers    		= 5       10		;
		}
52	loamy_sand_deep {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling3 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth3;
			PMacroThresh   		= $PMacroThresh3;  
			MacroCapacity  		= $MacroCapacity3; 
			CapacityRedu   		= $CapacityRedu3;   
			MacroDepth     		= $MacroDepth3;  
		    	horizon   		= 1       2		;
			Name			= T_Sl	  Sub_Sl	;  	
			ksat      		= $1e4    $5e5	    	;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.37    0.30  	; 	
			theta_res 		= 0.080   0.10  	;	
			(hPa)psi_FC		= $LS	  $LS		;
			alpha     		= 4.0 	  4.0		;	
			Par_n     		= 3.0     3.0   	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.20    1.5   	; #16m 
			layers    		= 5       10		;
		}
14	23_Seen_subhydrische_Boeden {
			method = MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling3 ; 	
			MaxInterflowDepth	= $MaxInterflowdepth3 ;
			PMacroThresh		= 0;  
			MacroCapacity		= 0; 
			CapacityRedu		= 0;   
			MacroDepth		= 0;  
			horizon			= 1	2	3	;  	
			Name			= SIL	SIL	CL	;  	
			ksat			= $3e7	$1e7	$1e7	; 
			k_recession		= 0.9	0.9	0.9	;  	
			theta_sat		= 0.45	0.45	0.40	;	
			theta_res		= 0.067	0.067	0.095	;	
			(hPa)psi_FC		= $SIL	$SIL	$CL	;
			alpha			= 2.00	2.0	1.90	;	
			Par_n			= 1.41	1.41	1.31	;	
			Par_tau			= 0.5	0.5	0.5	;  	
			thickness		= 0.10	0.30	2.00	;	# 19.0 m
			layers			= 4	2	9	;
		}
15	13_Siedlungsflaechen {
			method = MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ;
			MaxInterflowDepth 	= $MaxInterflowdepth1 ;
			PMacroThresh   		= 8.0 ;  
			MacroCapacity  		= 0.5 ; 
			CapacityRedu   		= 0.7 ;   
			MacroDepth     		= 1.0 ;  
			horizon   		= 1       2	  3	 ;  	
			Name			= SIL	  SIL	  R	 ;  	
			ksat      		= $1e6 	  $3e7    $5e8   ;
			k_recession		= 0.9     0.9     0.9    ;  	
			theta_sat 		= 0.45    0.45    0.20   ;	
			theta_res 		= 0.067   0.067   0.04   ;	
			(hPa)psi_FC		= $SIL	  $SIL	  $R	 ;
			alpha     		= 2.0 	  2.0	  8.0	 ;	
			Par_n     		= 1.41    1.41    1.80   ;	
			Par_tau			= 0.5	  0.5	  0.5	 ;  	
			thickness 		= 0.10    0.20    0.375  ;	# 4.0 m
			layers    		= 4       3       8      ;
        }
16	91_Felsflaechen {
			method = MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ; 				
 			MaxInterflowDepth 	= $MaxInterflowdepth1 ;
			PMacroThresh   		= 8.0 ;  
			MacroCapacity  		= 0.5 ; 
			CapacityRedu   		= 0.7 ;   
			MacroDepth     		= 1.0 ;  
		    	horizon   		= 1       2	 3	4	;  	
			Name			= SIL	  CL	 R	R	;  	
			ksat      		= $1e5    $3e6 	 $1e6	$1e6    ; 
			k_recession 		= 0.9     0.9    0.9    0.9     ;  	
			theta_sat 		= 0.45    0.41   0.20   0.20    ;	
			theta_res 		= 0.067   0.095  0.04   0.04    ;	
			(hPa)psi_FC		= $SIL	  $CL	 $R	$R	;
			alpha     		= 2.00 	  1.90	 8.00	8.00	;	
			Par_n     		= 1.41    1.31   1.80   1.80    ;	
			Par_tau			= 0.5	  0.5	 0.5	0.5	;  	
			thickness 		= 0.10    0.10   0.10   0.2     ; #	= 2.0 m
			layers    		= 2       3      5      5      	;
        }


[substance_transport]
$do_substance_transport

[irrigation_table]
$do_irrigation_table                  

[special_output]
$do_special_output 
$time 
