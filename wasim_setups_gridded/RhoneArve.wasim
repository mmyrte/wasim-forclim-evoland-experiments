$set $hhSnowStack	= hhydsnow_stack//.//$suffix	# stack with hydraulic heads per snow layer
$set $hgeoSnowStack	= hgeosnow_stack//.//$suffix	# stack with geodetic elevation per snow layer (bottom of layer)
$set $quSnowStack	= qusnow_stack//.//$suffix	# stack with (bottom) water fluxes per snow layer
