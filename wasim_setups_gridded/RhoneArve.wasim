$do_soil_model
$time


# the following declarations will be used in routing descriotions for easier switching on and of  of reservoirs.
# because: if one simply removes a reservoir with its depending abstractions and inflows, the numbering of abstractions and inflows is no longer 
# without gap. So this list of abstractions can be used to close this gap (by renumbering all values in a manner that 
# all n remaining abstractions and inflows are numbered without gap from 1 to n
#the symbols are used consistently for inflows and outflows.
$set $1   = 1
$set $2   = 2
$set $3   = 3
$set $4   = 4
$set $5   = 5
$set $6   = 6
$set $7   = 7
$set $8   = 8
$set $9   = 9
$set $10  = 10
$set $11  = 11
$set $12  = 12
$set $13  = 13
$set $14  = 14
$set $15  = 15
$set $16  = 16
$set $17  = 17
$set $18  = 18
$set $19  = 19
$set $20  = 20
$set $21  = 21
$set $22  = 22
$set $23  = 23
$set $24  = 24
$set $25  = 25
$set $26  = 26
$set $27  = 27
$set $28  = 28
$set $29  = 29
$set $30  = 30
             
$set $dtmin1 = 20 # Sekundenzeitschritt, in dem Stauseen aktualisiert werden (insbesondere kleine SPs m ssen hier kleiner 60 haben um numerisch stabil zu bleiben
$set $dtmin2 = 120 # Sekundenzeitschritt, in dem Stauseen aktualisiert werden (grosse Seen, 1min reicht aus)

$set $ManningH = 30.0

[routing_model]
$do_routing_model                    	
$time
