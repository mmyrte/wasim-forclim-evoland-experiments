3	Clay_light_shallow {
			method 			= MultipleHorizons;
			ThicknessScaling	= $ThicknessScaling1 ; 		
 			MaxInterflowDepth 	= $MaxInterflowdepth1 ;
			PMacroThresh   		= $PMacroThresh1;  
			MacroCapacity  		= $MacroCapacity1; 
			CapacityRedu   		= $CapacityRedu1;   
			MacroDepth     		= $MacroDepth1;  
		    	horizon   		= 1       2		;
			Name			= T_Cu	  Sub_Cu	;  	
			ksat      		= $4e7 	  $3e7		;	
			k_recession 		= 0.95    0.95  	;
			theta_sat 		= 0.43    0.45  	; 	
			theta_res 		= 0.078   0.067 	;	
			(hPa)psi_FC		= $SIC	  $SIC		;
			alpha     		= 1.47 	  1.47		;	
			Par_n     		= 1.25    1.25  	;	
			Par_tau			= 0.5	  0.5		;  	
			thickness 		= 0.10    0.15  	; #2m 
