# Doubs, 2021-01-01 to 01-11, hourly: reference run for the GT4Py snow prototype (gt4py/README.md)
# changes against golden/doubs/control.wasim.in: snow method 1, interception method 1, per-step netCDF output of tcor, prec, etrs, ssno, sliq, qsno
# == protected part to be changed by the module adapter ==
# == all manual changes in this section will be overwritten by the module adapter ==

$set $runID1      = 2021
$set $runID2      = 2022


$set $mainpath       = @CASE_DIR@/
$set $inpath         =  $mainpath//Input/
$set $exchngpath     =  @OUT_DIR@/
$set $InitialStateDirectory = $mainpath//StateIni_$runID1///
$set $DefaultOutputDirectory = @OUT_DIR@/

$set $time           = 60

$set $starthour      = 1
$set $startday       = 1
$set $startmonth     = 1
$set $startyear      = $runID1
$set $endhour        = 0
$set $endday         = 11
$set $endmonth       = 1
$set $endyear        = $runID1



# it is important to set $outpath to an empty string in order to activate $DefaultOutputDirectory
$set $outpath        =  

# readgrids : 1 = read storage grids (as SI, SSNOW,SLIQ...) from hard disk, 0=generate and initialize with 0
$set $readgrids     =  1

# read grids for dynamic phenology -> usually chilling grid should be read in if availabe because otherwise thermal time method will be applied and not the sequential model
$set $DPreadgrids   =  1

# == end of protected part ==


$set $subdir_ingrids = grids/
$set $subdir_timeseries = timeseries/

$set $do_RegionalSuperposition = 0
$set $do_precipitation_correction = 1
$set $do_radiation_correction = 1
$set $do_evapotranspiration = 1
$set $do_snow_model = 1
$set $do_interception_model = 1
$set $do_infiltration_model = 0
$set $do_SiltingUpModel = 0
$set $do_SurfaceRoutingModel = 0
$set $do_lake_model = 1
$set $do_unsatzon_model = 1
$set $do_soil_model = 0
$set $do_heat_transfer = 0
$set $do_ExternalCoupling = 0
$set $do_irrigation = 0
$set $do_groundwater_flow = 1
$set $do_routing_model = 1
$set $do_substance_transport = 0
$set $do_irrigation_table = 0
$set $do_special_output = 0
$set $do_data_assimilation = 0
$set $do_spin_up = 0

$set $DPreadgrids   = 0

$set $grid           = doubs500
$set $stack          = doubs500
$set $suffix         = grd
$set $code           = s


# kd --> recession constant for single linear reservoir for direct runoff
$set $kd1     = 2
$set $kd2     = 2 
$set $kd3     = 2 
$set $kd4     = 2 
$set $kd5     = 2 
$set $kd6     = 2
$set $kd7     = 2 
$set $kd8     = 2 
$set $kd9     = 2 
$set $kd10    = 2 
$set $kd11    = 2
$set $kd12    = 2
$set $kd13    = 2
$set $kd14    = 2
$set $kd15    = 2
$set $kd16    = 2
$set $kd17    = 2
$set $kd18    = 2
$set $kd19    = 2
$set $kd20    = 2

# ki --> recession constant for single linear reservoir for interflow
$set $ki1     = 3
$set $ki2     = 3 
$set $ki3     = 3 
$set $ki4     = 3
$set $ki5     = 3 
$set $ki6     = 3
$set $ki7     = 3 
$set $ki8     = 3 
$set $ki9     = 3 
$set $ki10    = 3 
$set $ki11    = 3
$set $ki12    = 3
$set $ki13    = 3
$set $ki14    = 3
$set $ki15    = 3
$set $ki16    = 3
$set $ki17    = 3
$set $ki18    = 3
$set $ki19    = 3
$set $ki20    = 3

# dr --> drainage density (interflow generation parameter)
$set $dr1     = 48.0  # 
$set $dr2     = 48.0  # 
$set $dr3     = 48.0  # 
$set $dr4     = 48.0  # 
$set $dr5     = 48.0  # 
$set $dr6     = 48.0  # 
$set $dr7     = 48.0  # 
$set $dr8     = 48.0  # 
$set $dr9     = 12.0  # water should go into groundwater and beeing extracted from there to Aare-JGK
$set $dr10    = 48.0  # 
$set $dr11    = 48.0  # 
$set $dr12    = 12.0  # water should go into groundwater and beeing extracted from there to Aare-JGK
$set $dr13    = 48.0  # 
$set $dr14    = 48.0  # 
$set $dr15    = 48.0  # 
$set $dr16    = 48.0  # 
$set $dr17    = 48.0  # 
$set $dr18    = 48.0  # 
$set $dr19    = 48.0  # 
$set $dr20    = 48.0  # 

# sdf --> Snow melt: Direct Runoff fraction
$set $sdf1     = 0.05
$set $sdf2     = 0.05 
$set $sdf3     = 0.05 
$set $sdf4     = 0.05 
$set $sdf5     = 0.05 
$set $sdf6     = 0.05
$set $sdf7     = 0.05 
$set $sdf8     = 0.05 
$set $sdf9     = 0.05 
$set $sdf10    = 0.05 
$set $sdf11    = 0.05
$set $sdf12    = 0.05
$set $sdf13    = 0.05
$set $sdf14    = 0.05
$set $sdf15    = 0.05
$set $sdf16    = 0.05
$set $sdf17    = 0.05
$set $sdf18    = 0.05
$set $sdf19    = 0.05
$set $sdf20    = 0.05

# variables for standardgrids
# first section: grids, which differ for different subdivisions of the basin
$set $zone_grid             =  $grid//.e19
$set $subcatchments         =  $grid//.ezg
$set $flow_time_grid        =  $grid//.fzs_05 
$set $river_links_grid      =  $grid//.lnk
$set $regio_grid            =  $grid//.reg

#second section: grids, which doesn't depend on subdivision (only pixel-values are of interest)
$set $elevation_model       =  $grid//.dhk_lakesconst3
$set $RelCellArea_grid      =  $grid//.rca
$set $CellSizeX_grid        =  $grid//.csx
$set $CellSizeY_grid        =  $grid//.csy
$set $slope_grid            =  $grid//.slp
$set $FlowDirection_grid    =  $grid//.fld
$set $aspect_grid           =  $grid//.exp
$set $land_use_grid         =  $grid//.use
$set $ice_firn_grid         =  $grid//.ice
$set $field_capacity_grid   =  $grid//.nfk
$set $ATBgrid               =  $grid//.atb
$set $hydr_cond_grid        =  $grid//.k
$set $soil_types            =  $grid//.soil
$set $sky_view_factor_grid  =  $grid//.hor
$set $drain_depth_grid      =  $grid//.drn
$set $drain_distance_grid   =  $grid//.dis
$set $irrigationcodes       =  $grid//.irr19
$set $max_pond_grid         =  $grid//.maxpond_c
$set $clay_depth_grid       =  $grid//.cly
$set $river_depth_grid      =  $grid//.dep2_0
$set $river_width_grid      =  $grid//.wit5_0
$set $tracer_1              =  $grid//.c1
$set $tracer_2              =  $grid//.c2
$set $tracer_3              =  $grid//.c3
$set $tracer_4              =  $grid//.c4
$set $tracer_5              =  $grid//.c5
$set $tracer_6              =  $grid//.c6
$set $tracer_7              =  $grid//.c7
$set $tracer_8              =  $grid//.c8
$set $tracer_9              =  $grid//.c9
$set $kolmationsgrid        =  $grid//.kol
$set $gw_kx_1_grid          =  $grid//.kx1
$set $gw_kx_2_grid          =  $grid//.kx2
$set $gw_kx_3_grid          =  $grid//.kx3
$set $gw_ky_1_grid          =  $grid//.ky1
$set $gw_ky_2_grid          =  $grid//.ky2
$set $gw_ky_3_grid          =  $grid//.ky3
$set $gw_bound_h_1_grid     =  $grid//.bh1
$set $gw_bound_h_2_grid     =  $grid//.bh2
$set $gw_bound_h_3_grid     =  $grid//.bh3
$set $gw_bound_q_1_grid     =  $grid//.bq1a
$set $gw_bound_q_2_grid     =  $grid//.bq2
$set $gw_bound_q_3_grid     =  $grid//.bq3
$set $aquiferthick1         =  $grid//.aq1
$set $aquiferthick2         =  $grid//.aq2
$set $aquiferthick3         =  $grid//.aq3
$set $gw_storage_coeff_1    =  $grid//.s01
$set $gw_storage_coeff_2    =  $grid//.s02
$set $gw_storage_coeff_3    =  $grid//.s03
$set $gw_kolmation_1        =  $grid//.gk1
$set $gw_kolmation_2        =  $grid//.gk2
$set $gw_kolmation_3        =  $grid//.gk3
$set $lake_grid             =  $grid//.lake_IDs2
$set $taucrit_grid          =  $grid//.tau
$set $ThawCoeffPermaFrost   =  $grid//.alpha
$set $debris_on_glaciers    =  $grid//.debris
$set $slidefraction1        =  $grid//.sd1
$set $slidefraction2        =  $grid//.sd2
$set $slidefraction3        =  $grid//.sd3
$set $slidefraction4        =  $grid//.sd4
$set $depositionindex       =  $grid//.svfdir_2_masked_normalized
$set $elevationordercols    =  $grid//.eoc
$set $elevationorderrows    =  $grid//.eor

# output grids for surface hydrology modules
$set $nFK_grid_mm_min      =  uFCminmm//.//$suffix 
$set $nFK_grid_mm_max      =  uFCmaxmm//.//$suffix 
$set $nFK_grid_mm          =  uFCmm//.//$suffix      
$set $nFK_grid_perc        =  uFCperc//.//$suffix 
$set $forcingunitsgrid1    =  forc1//.//$suffix
$set $TStartPhenoGrid1     =  phen1//.//$suffix
$set $chillingunitsgrid1   =  chill1//.//$suffix
$set $FStargrid1           =  fstar1//.//$suffix
$set $forcingunitsgrid2    =  forc2//.//$suffix
$set $TStartPhenoGrid2     =  phen2//.//$suffix
$set $chillingunitsgrid2   =  chill2//.//$suffix
$set $FStargrid2           =  fstar2//.//$suffix
$set $forcingunitsgrid3    =  forc3//.//$suffix
$set $TStartPhenoGrid3     =  phen3//.//$suffix
$set $chillingunitsgrid3   =  chill3//.//$suffix
$set $FStargrid3           =  fstar3//.//$suffix
$set $albedo               =  albedo//.//$suffix
$set $soilstoragegrid      =  sb__//.//$suffix
$set $throughfall          =  qi__//.//$suffix
$set $snowcover_outflow    =  qsno//.//$suffix
$set $melt_from_snowcover  =  qsme//.//$suffix
$set $days_snow            =  sday//.//$suffix
$set $snow_age             =  sage//.//$suffix
$set $snow_rate            =  snow//.//$suffix
$set $rain_rate            =  rain//.//$suffix
$set $firn_melt            =  qfir//.//$suffix
$set $ice_melt             =  qice//.//$suffix
$set $preci_grid           =  prec//.//$suffix
$set $preci_grid1          =  prec1//.//$suffix
$set $preci_grid2          =  prec2//.//$suffix
$set $irrig_grid           =  irri//.//$suffix
$set $etr2etpgrid          =  er2ep//.//$suffix
$set $tempegrid            =  temp//.//$suffix
$set $tempegrid1           =  temp1//.//$suffix
$set $tempegrid2           =  temp2//.//$suffix
$set $windgrid             =  wind//.//$suffix
$set $sunshinegrid         =  ssd_//.//$suffix
$set $radiationgrid        =  rad_//.//$suffix
$set $humiditygrid         =  humi//.//$suffix
$set $vaporgrid            =  vapo//.//$suffix
$set $ETPgrid              =  etp_//.//$suffix
$set $EIPgrid              =  eip_//.//$suffix
$set $ETRgrid              =  etr_//.//$suffix
$set $EVAPgrid             =  evap//.//$suffix
$set $EVARgrid             =  evar//.//$suffix
$set $ETRSgrid             =  etrs//.//$suffix
$set $SSNOgrid             =  ssno//.//$suffix
$set $SLIQgrid             =  sliq//.//$suffix
$set $SSTOgrid             =  swe_//.//$suffix
$set $SSNOOnGlacgrid       =  ssno_onGlac_//.//$suffix
$set $SLIQOnGlacgrid       =  sliq_onGlac_//.//$suffix
$set $SSTOOnGlacgrid       =  ssto_onGlac_//.//$suffix
$set $sat_def_grid         =  sd__//.//$suffix
$set $SUZgrid              =  suz_//.//$suffix
$set $SIFgrid              =  sif_//.//$suffix
$set $EIgrid               =  ei__//.//$suffix
$set $SIgrid               =  si__//.//$suffix
$set $ExpoCorrgrid         =  exco//.//$suffix
$set $Tcorrgrid            =  tcor//.//$suffix
$set $Shapegrid            =  shap//.//$suffix
$set $INFEXgrid            =  infx//.//$suffix
$set $SATTgrid             =  satt//.//$suffix
$set $Nagrid               =  na__//.//$suffix
$set $SSPgrid              =  ssp_//.//$suffix
$set $Peakgrid             =  peak//.//$suffix
$set $SBiagrid             =  sbia//.//$suffix
$set $fcia_grid            =  nfki//.//$suffix
$set $tavg_grid            =  tavg//.//$suffix

# now variables for unsaturated zone model
$set $SB_1_REL_grid  =  sb05rel//.//$suffix
$set $SB_1_grid      =  sb05//.//$suffix
$set $SB_2_grid      =  sb1_//.//$suffix
$set $ROOTgrid       =  wurz//.//$suffix
$set $QDgrid         =  qd__//.//$suffix
$set $QIgrid         =  qifl//.//$suffix
$set $GWdepthgrid    =  gwst//.//$suffix
$set $GWthetagrid    =  gwth//.//$suffix
$set $GWNgrid        =  gwn_//.//$suffix
$set $UPRISEgrid     =  uprs//.//$suffix
$set $PERCOLgrid     =  perc//.//$suffix
$set $GWLEVELgrid    =  gwlv//.//$suffix
$set $QDRAINgrid     =  qdrn//.//$suffix
$set $QBgrid         =  qb__//.//$suffix
$set $GWINgrid       =  gwin//.//$suffix
$set $GWEXgrid       =  gwex//.//$suffix
$set $act_pond_grid  =  pond//.//$suffix
$set $MACROINFgrid   =  macr//.//$suffix
$set $SUBSTEPSgrid   =  step//.//$suffix

$set $SnowFreeDaysGrid = sfre//.//$suffix
$set $SnowCoverDaysGrid = scov//.//$suffix
$set $ThawDepthGrid    = thdp//.//$suffix
$set $ThawDepthGridTMod = thaw//.//$suffix
$set $ts_avg		= ts_avg//.//$suffix

# variables for groundwater modeling
$set $flowx1grid     =  gwx1//.//$suffix
$set $flowx2grid     =  gwx2//.//$suffix
$set $flowx3grid     =  gwx3//.//$suffix
$set $flowy1grid     =  gwy1//.//$suffix
$set $flowy2grid     =  gwy2//.//$suffix
$set $flowy3grid     =  gwy3//.//$suffix
$set $head1grid      =  gwh1//.//$suffix
$set $head2grid      =  gwh2//.//$suffix
$set $head3grid      =  gwh3//.//$suffix
$set $GWbalance1grid =  gwbalance1//.//$suffix
$set $GWbalance2grid =  gwbalance2//.//$suffix
$set $GWbalance3grid =  gwbalance3//.//$suffix

# result grids for surface routing model
$set $surfspeed_grid        =  sfcv//.//$suffix
$set $surfflux_grid         =  sflx//.//$suffix

# some new stacks and grids for the dynamic glacier model
$set $firn_WE_stack           = glfirn//.//$suffix
$set $GlacierMassBalance      = glmb//.//$suffix
$set $OldGlacierMassBalance   = glmb_old//.//$suffix
$set $glacierizedCells_grid   = glc_//.//$suffix
$set $glacier_codes_grid      = glid//.//$suffix

# result-stacks for Unsatzonmodel
$set $Thetastack              = thet//.//$suffix
$set $hydraulic_heads_stack   = hhyd//.//$suffix
$set $geodetic_altitude_stack = hgeo//.//$suffix
$set $flowstack               = qu__//.//$suffix
$set $concstack               = conc//.//$suffix
$set $Temperaturestack	      = tsoil//.//$suffix

# result-grids for snow model
$set $snowtemperaturgrid       = snowtemp//.//$suffix
$set $snowsurftemperaturgrid   = ssrftemp//.//$suffix
$set $inputmassgrid            = inpmass//.//$suffix
$set $mobilemassgrid           = mobmass//.//$suffix
$set $depositiongrid           = deposit//.//$suffix
$set $snowtemperaturgridGL     = snowtempgl//.//$suffix
$set $snowsurftemperaturgridGL = ssrftempgl//.//$suffix
$set $ETRSgridGl               = etrsgl//.//$suffix
$set $QSNOWOnGlacgrid	       = qsmegl//.//$suffix

# result-stacks for layered snow model
$set $SWESstack			= swes_stack//.//$suffix	# stack with SWE solid values per snow layer
$set $SWELStack			= swel_stack//.//$suffix	# stack with SWE liquid values per snow layer
$set $temperSnowStack		= tempersnow_stack//.//$suffix	# stack with snow temperatures per snow layer
$set $thetaSnowStack		= thetasnow_stack//.//$suffix	# stack with theta values per snow layer
$set $hhSnowStack		= hhydsnow_stack//.//$suffix	# stack with hydraulic heads per snow layer
$set $hgeoSnowStack		= hgeosnow_stack//.//$suffix	# stack with geodetic elevation per snow layer (bottom of layer)
$set $quSnowStack		= qusnow_stack//.//$suffix	# stack with (bottom) water fluxes per snow layer
$set $thickSnowStack		= thicksnow_stack//.//$suffix	# stack with the thickness of each snow layer
$set $densSnowStack		= denssnow_stack//.//$suffix	# stack with density of each snow layer
$set $upperIndexSnow		= upperIndexSnow//.//$suffix	# grid with the index of the first (uppermost) layer that constains snow


# parameters for interpolation of meteorological input data
$set $SzenUse        =  0
$set $IDWmaxdist     =  100000
$set $IDWweight      =  2
$set $Anisoslope     =  45.0
$set $Anisotropie    =  0.8


# explanation of writegrid and outputcode some lines below
$set $Writegrid_series 	= 3
$set $Writegrid      	= 3
$set $Write_no_grid  	= 0
$set $Writestack     	= 3
$set $Write_no_stack 	= 0

$set $no_output  	 = 0
$set $once_per_interval  = 2001
$set $routing_code       = 4001


[SpinUp]
$do_spin_up


[output_list]
9     # number of subbasins which are scheduled for output (is only of interest, if the code for the statistic files are >5000)
1		
3	
8	
10	
12	
14
16
17
19


[output_interval]
25             # increment of time steps until an output to the screen is done (24 = each day one output, if time steo = 1h)
1              # warning level for interpolation (no station within search radius)
1              # output of runoff results in 0=mm/time step, 1=m3/s   
$time          # minutes from the hour-entry in the input data files until the end 
# of the time step is reached 0 if the end of time step is given like "84 01 01 01", 
# but it should be $time if the begin is given like in "84 01 01 00"
WriteAsciiGrids = 1 					# 0 if grids should be written in WaSiM native format, 1 if in ESRI ASCII format
WriteDoubleGrids = 1 					# 0 if grids should be written in WaSiM native format, 1 if in ESRI ASCII format
WriteNetcdfGrids = 1
InitialStateDirectory = $InitialStateDirectory 		# if using this parameter, all state grids  as well as the storage_richards.ftz file will be expected in that directory for reading
DefaultOutputDirectory = $DefaultOutputDirectory 	# this is the default output directory, all output is written to unless the given filename contains an absolute path (starting with either / or ~ for UNIX or a drive letter and :/ for Windows


[coordinates]
47.0           # geogr. latitude (center of the basin -> for radiation calculations)
6.6            # geogr. longitude (center of the basin)
15.0           	# meridian according to the official time (middle europe: 15)(east: 0 ... +180 degree, west: 0 ... -180 (or 360 ... 180)
0               # time shift of Meteo-data-time with respect to the true local time (mean sun time)

[region_transition_distance]
15000 # in m


[soil_surface_groundwater_substeps]
1 # number of sub time steps for the module group surface routing, unsaturated zone model and groundwater model (and accumulation of real evapotranspiration)


[elevation_model]
$inpath//$subdir_ingrids//$elevation_model    

[zone_grid]
$inpath//$subdir_ingrids//$zone_grid       


[standard_grids]
30                            	
$inpath//$subdir_ingrids//$nFK_grid_mm_min      minFieldCapacity_mm	  fillcode = 1 defaultValue = 100 readcode = 0 outname = $outpath//$nFK_grid_mm_min   	writecode = $Write_no_grid  			# maximum usable field capacity in mm (depends on soil property psi_FC, or 200cm suction as default, calculated over the actual root depth at every time step, result of max grid is available when writecode contains a max output like 2xx)
$inpath//$subdir_ingrids//$nFK_grid_mm_max      maxFieldCapacity_mm	  fillcode = 1 defaultValue = 100 readcode = 0 outname = $outpath//$nFK_grid_mm_max   	writecode = $Write_no_grid  			# maximum usable field capacity in mm (depends on soil property psi_FC, or 200cm suction as default, calculated over the actual root depth at every time step, result of max grid is available when writecode contains a max output like 2xx)
$inpath//$subdir_ingrids//$nFK_grid_mm          usableFieldCapacity_mm    fillcode = 1 defaultValue = 100 readcode = 0 outname = $outpath//$nFK_grid_mm      	writecode = $Writegrid	statfile = $outpath//uFCmm.dat 		statcode = $once_per_interval  	# actual usable water capacity in mm (depends on max field capacity and the actual water content)
$inpath//$subdir_ingrids//$nFK_grid_perc        usableFieldCapacity_perc  fillcode = 1 defaultValue = 100 readcode = 0 outname = $outpath//$nFK_grid_perc     	writecode = $Writegrid	statfile = $outpath//uFCperc.dat 	statcode = $once_per_interval  	# actual usable field capacity in % (depends on max field capacity and the actual water content)
$inpath//$subdir_ingrids//$SB_1_REL_grid        SB_1_REL_grid             fillcode = 1  defaultValue = 1.0 readcode = 0 outname = $outpath//$SB_1_REL_grid  	writecode = $Writegrid	statfile = $outpath//sb_1_rel.dat 	statcode = $once_per_interval  	# 
$inpath//$subdir_ingrids//$etr2etpgrid          ETR2ETP                   fillcode = 1  defaultValue = 1.0 readcode = 0 outname = $outpath//$etr2etpgrid  	writecode = $Writegrid	statfile = $outpath//etr2etp.dat 	statcode = $once_per_interval  	# 
$inpath//$subdir_ingrids//$slope_grid       	slope_angle               1    			# grid with slope angle data
$inpath//$subdir_ingrids//$aspect_grid      	slope_aspect              1    			# grid with slope aspect data
$inpath//$subdir_ingrids//$land_use_grid    	landuse  		  fillcode = 1 		# writecode = 8 readcode = 1 outname = $outpath//$land_use_grid # grid with land use data (will be written out after reading in for getting gthe filles values)
$inpath//$subdir_ingrids//$subcatchments    	zonegrid_soilmodel        1    			# zone grid for the runoff generation model (and unstaurated zone model)
$inpath//$subdir_ingrids//$flow_time_grid   	flow_times                fillcode = 1 		# writecode = 8 readcode = 1 outname = $outpath//$flow_time_grid  		# grid with flow times for surface runoff to the subbasin outlet
$inpath//$subdir_ingrids//$river_links_grid     river_links               0    			# grid with codes of tributaries, from which a channel was routed (only for real routing channels!!!)
$inpath//$subdir_ingrids//$slidefraction1	slidefraction1		  fillcode = 0 		# new snow model extensions: fraction of the area flowing to the North (slides)
$inpath//$subdir_ingrids//$slidefraction2	slidefraction2		  fillcode = 0 		# new snow model extensions: fraction of the area flowing to the West (slides)
$inpath//$subdir_ingrids//$slidefraction3	slidefraction3		  fillcode = 0 		# new snow model extensions: fraction of the area flowing to the East (slides)
$inpath//$subdir_ingrids//$slidefraction4	slidefraction4		  fillcode = 0 		# new snow model extensions: fraction of the area flowing to the South (slides)
$inpath//$subdir_ingrids//$depositionindex      deposition_index          fillcode = 1 		# new snow model extensions: correction factor for wind impact on snow fall
$inpath//$subdir_ingrids//$river_depth_grid     river_depth               0    			# grid with the depth of all streams in the stream network in m
$inpath//$subdir_ingrids//$river_width_grid     river_width               0    			# grid with the witdh of all streams in m
$inpath//$subdir_ingrids//$lake_grid		lake_codes                fillcode = 0 		# grid with a unique code for each lake
$inpath//$subdir_ingrids//$soil_types       	soil_types                fillcode = 1 		# writecode = 8 readcode = 1 outname = $outpath//$soil_types     		# soil types as codes for the soil table
$inpath//$subdir_ingrids//$kolmationsgrid       kolmation                 fillcode = 1 		# defaultValue = 1e-5   writecode = 8 readcode = 0 #outname = $outpath//$kolmationsgrid     # grid with codes of tributaries, from which a channel was routed (only for real routing channels!!!)
$inpath//$subdir_ingrids//$aquiferthick1        aquifer_thickness_1       fillcode = 1 		# writecode = 8 readcode = 1 outname = $outpath//$aquiferthick1      # grid with thickness of first aquifer (m from soil surface to the aquifer bottom)
$inpath//$subdir_ingrids//$gw_storage_coeff_1   gw_storage_coeff_1        fillcode = 1 		# defaultValue = 0.1    writecode = 8 readcode = 0 #outname = $outpath//$gw_storage_coeff_1 # storage coefficients for 1. aquifer
$inpath//$subdir_ingrids//$gw_bound_h_1_grid    gw_boundary_fix_h_1       fillcode = 0 		# defaultValue = -9999  writecode = 8 readcode = 0 #outname = $outpath//$gw_bound_h_1_grid  # periodicity = 1 D 12 persistent = 0 # boundary conditions 1 constant head for layer 1
$inpath//$subdir_ingrids//$gw_bound_q_1_grid    gw_boundary_fix_q_1       fillcode = 0 		# defaultValue = -9999  writecode = 8 readcode = 0 #outname = $outpath//$gw_bound_q_1_grid  # boundary conditions 2 (given flux perpendicular to the border) for layer 1
$inpath//$subdir_ingrids//$gw_kx_1_grid         gw_k_x_1                  fillcode = 1 		# defaultValue = 1e-5   writecode = 8 readcode = 0 #outname = $outpath//$gw_kx_1_grid	# lateral hydraulic conductivities for the 1. aquifer in x direction
$inpath//$subdir_ingrids//$gw_ky_1_grid         gw_k_y_1                  fillcode = 1 		# defaultValue = 1e-5   writecode = 8 readcode = 0 #outname = $outpath//$gw_ky_1_grid	# lateral hydraulic conductivities for the 1. aquifer in y direction
$inpath//$subdir_ingrids//$gw_kolmation_1       gw_kolmation_1            fillcode = 1 		# defaultValue = 1e-5   writecode = 8 readcode = 0 # kolmation (leakage factor) between 1st and 2nd aquifer
$inpath//$subdir_ingrids//$max_pond_grid        max_ponding_storage       fillcode = 1 defaultValue = 0 	# grid with height of small dams around the fields for water ponding (in m). 0 if no ponding occurs. For a call which is active in the lake grid, this value is the theoretical value when the pond overflows.


